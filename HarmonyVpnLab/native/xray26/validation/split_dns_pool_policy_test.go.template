func (splitDNSRouteContext) GetLocalIPs() []xnet.IP           { return nil }
func (splitDNSRouteContext) GetSourcePort() xnet.Port         { return 0 }
func (splitDNSRouteContext) GetLocalPort() xnet.Port          { return 0 }
func (splitDNSRouteContext) GetTargetPort() xnet.Port         { return 443 }
func (splitDNSRouteContext) GetTargetDomain() string          { return "" }
func (splitDNSRouteContext) GetNetwork() xnet.Network         { return xnet.Network_TCP }
func (splitDNSRouteContext) GetProtocol() string              { return "https" }
func (splitDNSRouteContext) GetUser() string                  { return "" }
func (splitDNSRouteContext) GetVlessRoute() xnet.Port         { return 0 }
func (splitDNSRouteContext) GetAttributes() map[string]string { return nil }
func (splitDNSRouteContext) GetSkipDNSResolve() bool          { return true }
func splitDNSValidate(f splitDNSFixture) (out splitDNSResult) {
	out.Name = f.Name
	out.ConfigSHA256 = f.ConfigSHA256
	out.CaseCount = len(f.Cases)
	defer func() {
		if recover() != nil {
			out.Passed = false
			out.Failure = "PINNED_DNS_PANIC"
		}
	}()
	c := &Config{}
	rc := &router.Config{}
	if proto.Unmarshal(f.DNS, c) != nil || proto.Unmarshal(f.Router, rc) != nil {
		out.Failure = "PREPARED_PROTO_REJECTED"
		return
	}
	if failure := splitDNSProtoCheck(c); failure != "" {
		out.Failure = failure
		return
	}
	d, err := splitDNSNew(c)
	if err != nil {
		out.Failure = "PINNED_DNS_NEW_REJECTED"
		return
	}
	// Check real NewClient-created resources before swapping leaves, including
	// the same URL used by Google and the remote catch-all.
	for i, a := range d.clients {
		da, ok := a.server.(*DoHNameServer)
		if !ok {
			out.Failure = "NON_DOH_SERVER_CREATED"
			return
		}
		for j, b := range d.clients {
			if i >= j {
				continue
			}
			db, ok := b.server.(*DoHNameServer)
			if !ok || da == db || da.cacheController == db.cacheController || da.httpClient == db.httpClient {
				out.Failure = "CACHE_OR_CLIENT_SHARED"
				return
			}
			expectedShared := da.shareRemoteHTTPS && db.shareRemoteHTTPS && da.dohURL == db.dohURL && a.tag == b.tag
			if (da.httpClient.Transport == db.httpClient.Transport) != expectedShared {
				out.Failure = "TRANSPORT_EQUIVALENCE_FAILED"
				return
			}
			da.cacheController.ips["synthetic-cache.invalid."] = &record{}
			if _, exists := db.cacheController.ips["synthetic-cache.invalid."]; exists {
				out.Failure = "CACHE_RECORD_CROSSED_GROUP"
				return
			}
			delete(da.cacheController.ips, "synthetic-cache.invalid.")
		}
	}
	out.CacheIsolation = true
	mocks := splitDNSMocks(d)
	for _, test := range f.Cases {
		if test.ExpectedClientIndex < 0 || test.ExpectedClientIndex >= len(mocks) {
			out.Failure = "EXPECTED_INDEX_OUT_OF_RANGE"
			return
		}
		for _, m := range mocks {
			m.calls = 0
			m.fail = false
			m.inboundTag = ""
		}
		mocks[test.ExpectedClientIndex].fail = test.FailSelected
		selected := d.sortClients(test.Domain)
		if len(selected) != 1 || selected[0] != d.clients[test.ExpectedClientIndex] {
			out.Failure = "DNS_SELECTED_CLIENT_MISMATCH"
			return
		}
		ips, _, lookupErr := d.LookupIP(test.Domain, fdns.IPOption{IPv4Enable: true})
		if test.FailSelected {
			if lookupErr == nil || len(ips) != 0 {
				out.Failure = "FAILED_QUERY_DID_NOT_FAIL_CLOSED"
				return
			}
		} else {
			if lookupErr != nil || len(ips) != 1 {
				out.Failure = "SELECTED_QUERY_DID_NOT_SUCCEED"
				return
			}
		}
		for i, m := range mocks {
			want := 0
			if i == test.ExpectedClientIndex {
				want = 1
			}
			if m.calls != want {
				out.Failure = "CROSS_RESOLVER_FALLBACK"
				return
			}
		}
		if mocks[test.ExpectedClientIndex].inboundTag != d.clients[test.ExpectedClientIndex].tag {
			out.Failure = "QUERY_TAG_MISMATCH"
			return
		}
		out.PassedCases++
	}
	out.TagIsolation = true
	if len(rc.BalancingRule) != 0 {
		out.Failure = "BALANCER_FORBIDDEN"
		return
	}
	for _, rule := range rc.Rule {
		if rule.Webhook != nil || len(rule.Process) > 0 || rule.GetBalancingTag() != "" || !slices.Contains(f.OutboundTags, rule.GetTag()) {
			out.Failure = "IMPURE_OR_UNBOUND_ROUTING_RULE"
			return
		}
	}
	r := &router.Router{}
	if r.Init(context.Background(), rc, d, nil, splitDNSDispatcher{}) != nil {
		out.Failure = "ROUTER_INIT_REJECTED"
		return
	}
	defer r.Close()
	for i, client := range d.clients {
		callsBefore := 0
		for _, m := range mocks {
			callsBefore += m.calls
		}
		want := "nodeProxy"
		if len(d.clients) == 3 && i == 1 {
			want = "direct"
		}
		route, err := r.PickRoute(splitDNSRouteContext{tag: client.tag, ip: xnet.IP{223, 5, 5, 5}})
		if err != nil || route.GetOutboundTag() != want {
			out.Failure = "DNS_ROUTING_TAG_MISMATCH"
			return
		}
		callsAfter := 0
		for _, m := range mocks {
			callsAfter += m.calls
		}
		if callsAfter != callsBefore {
			out.Failure = "DNS_ROUTE_RECURSIVE_LOOKUP"
			return
		}
		out.RoutingAssertions++
	}
	if len(c.NameServer) == 3 {
		// Deliberately overlap the direct domain list with the Google list and
		// remove only Google's finalQuery: selected failure must then call direct.
		// This demonstrates why disableFallback alone is not a sufficient guard.
		bad := proto.Clone(c).(*Config)
		bad.NameServer[0].FinalQuery = false
		bad.NameServer[1].Domain = append(bad.NameServer[1].Domain, bad.NameServer[0].Domain...)
		nd, e := splitDNSNew(bad)
		if e != nil {
			out.Failure = "NEGATIVE_CONTROL_SETUP"
			return
		}
		nm := splitDNSMocks(nd)
		nm[0].fail = true
		_, _, e = nd.LookupIP("www.google.com", fdns.IPOption{IPv4Enable: true})
		if e != nil || nm[0].calls != 1 || nm[1].calls != 1 || nm[2].calls != 0 {
			out.Failure = "NEGATIVE_CONTROL_NOT_EXPOSED"
			return
		}
		out.NoFinalQueryNegativeControl = true
	}
	out.Passed = true
	return
}
func TestHarmonySplitDNSPoolPolicyFixtures(t *testing.T) {
	path := os.Getenv("HARMONY_SPLIT_DNS_PREPARED")
	output := os.Getenv("HARMONY_SPLIT_DNS_RESULT")
	if path == "" || output == "" {
		t.Fatal("VALIDATION_PATHS_REQUIRED")
	}
	b, err := os.ReadFile(path)
	if err != nil || len(b) > 8*1024*1024 {
		t.Fatal("PREPARED_READ_FAILED")
	}
	var fs []splitDNSFixture
	if json.Unmarshal(b, &fs) != nil || len(fs) == 0 {
		t.Fatal("PREPARED_FIXTURES_INVALID")
	}
	previousResolver, previousClient, previousTransport := net.DefaultResolver, http.DefaultClient, http.DefaultTransport
	net.DefaultResolver = &net.Resolver{PreferGo: true, Dial: func(context.Context, string, string) (net.Conn, error) {
		splitDNSBlocked.Add(1)
		return nil, errors.New("SYSTEM_DNS_FORBIDDEN")
	}}
	http.DefaultTransport = splitDNSDenyHTTP{}
	http.DefaultClient = &http.Client{Transport: splitDNSDenyHTTP{}}
	internet.UseAlternativeSystemDialer(splitDNSDenySystem{})
	defer func() {
		net.DefaultResolver = previousResolver
		http.DefaultClient = previousClient
		http.DefaultTransport = previousTransport
		internet.UseAlternativeSystemDialer(nil)
	}()
	report := splitDNSReport{CoreVersion: core.Version(), Passed: true, Scope: "Fixed real JSON-loader protobufs, DNS.New, packaged geosite matching, LookupIP/QueryIP, real Router.PickRoute; in-memory leaf DNS only; no core start or sockets"}
	for _, f := range fs {
		result := splitDNSValidate(f)
		report.Results = append(report.Results, result)
		if !result.Passed {
			report.Passed = false
			t.Errorf("%s: %s", strings.ReplaceAll(f.Name, "\n", " "), result.Failure)
		}
	}
	report.BlockedNetworkAttempts = splitDNSBlocked.Load()
	if report.BlockedNetworkAttempts != 0 {
		report.Passed = false
		t.Error("NETWORK_ATTEMPT_BLOCKED")
	}
	encoded, err := json.MarshalIndent(report, "", "  ")
	if err != nil || os.WriteFile(output, encoded, 0600) != nil {
		t.Fatal("REPORT_WRITE_FAILED")
	}
}
