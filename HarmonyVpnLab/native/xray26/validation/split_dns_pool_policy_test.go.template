type splitDNSLeaf struct {
	index      int
	calls      int
	fail       bool
	inboundTag string
}

func (s *splitDNSLeaf) Name() string       { return fmt.Sprintf("synthetic-resolver-%d", s.index) }
func (*splitDNSLeaf) IsDisableCache() bool { return false }
func (s *splitDNSLeaf) QueryIP(ctx context.Context, _ string, _ fdns.IPOption) ([]xnet.IP, uint32, error) {
	s.calls++
	in := session.InboundFromContext(ctx)
	if in != nil {
		s.inboundTag = in.Tag
	}
	if s.fail {
		return nil, 0, errors.New("SYNTHETIC_SELECTED_RESOLVER_FAILURE")
	}
	return []xnet.IP{{192, 0, 2, byte(10 + s.index)}}, 60, nil
}
func splitDNSNew(c *Config) (*DNS, error) {
	instance := &core.Instance{}
	if err := instance.AddFeature(splitDNSDispatcher{}); err != nil {
		return nil, err
	}
	// XrayKey is exported explicitly for tests in this pinned revision. This is
	// not a supported application integration API and is not used in app code.
	ctx := context.WithValue(context.Background(), core.XrayKey(1), instance)
	return New(ctx, c)
}
func splitDNSMocks(d *DNS) []*splitDNSLeaf {
	m := make([]*splitDNSLeaf, len(d.clients))
	for i, c := range d.clients {
		m[i] = &splitDNSLeaf{index: i}
		c.server = m[i]
	}
	return m
}
func splitDNSProtoCheck(c *Config) string {
	if len(c.NameServer) != 1 && len(c.NameServer) != 3 {
		return "PROTO_DNS_SERVER_COUNT"
	}
	if c.QueryStrategy != QueryStrategy_USE_IP4 || !c.DisableFallback || !c.DisableFallbackIfMatch || c.EnableParallelQuery {
		return "PROTO_DNS_POLICY"
	}
	for i, s := range c.NameServer {
		u, err := url.Parse(s.Address.Address.GetDomain())
		if err != nil || u.Scheme != "https" || u.Host == "" {
			return "PROTO_ROUTED_DOH_REQUIRED"
		}
		if !s.SkipFallback || s.QueryStrategy != QueryStrategy_USE_IP4 || len(s.Domain) == 0 {
			return "PROTO_SERVER_POLICY"
		}
		tag := s.Tag
		if tag == "" {
			tag = c.Tag
		}
		want := "dns-via-node"
		if len(c.NameServer) == 3 {
			if !s.FinalQuery {
				return "PROTO_FINAL_QUERY"
			}
			if i == 1 {
				want = "dns-via-direct"
				if ip := net.ParseIP(u.Hostname()); ip == nil || ip.To4() == nil {
					return "PROTO_DIRECT_DOH_IPV4_REQUIRED"
				}
			}
		}
		if tag != want {
			return "PROTO_DNS_TAG"
		}
	}
	return ""
}

// Actual router matching, with SkipDNSResolve as set by routed DoH.
type splitDNSRouteContext struct {
	tag string
	ip  xnet.IP
}

func (c splitDNSRouteContext) GetInboundTag() string          { return c.tag }
func (c splitDNSRouteContext) GetTargetIPs() []xnet.IP        { return []xnet.IP{c.ip} }
