			}
		}})
		ctx, cancel := context.WithCancel(harmonyDoHCoreContext())
		defer cancel()
		result := make(chan error, 1)
		go func() {
			conn, err := client.transport.h2.DialTLSContext(ctx, "tcp", "127.0.0.1:4443", nil)
			if conn != nil {
