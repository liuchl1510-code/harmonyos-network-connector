	t.Run("production-h2c-wire-DNS-third-query-keeps-dispatch-context", func(t *testing.T) {
		listener, err := net.Listen("tcp", "127.0.0.1:0")
		if err != nil {
			t.Fatal(err)
		}
		serverDone := make(chan struct{}, 1)
		accepts, queries, dispatches := new(atomic.Int32), new(atomic.Int32), new(atomic.Int32)
		var serverMu sync.Mutex
		var accepted net.Conn
		t.Cleanup(func() {
			_ = listener.Close()
			serverMu.Lock()
			if accepted != nil {
				_ = accepted.Close()
			}
			serverMu.Unlock()
			harmonyDoHReceive(t, serverDone)
		})
		// This deliberately tests the production h2c constructor's real dispatch
		// lifecycle, not TLS verification or h2c sharing (h2c is never pooled).
		go func() {
			defer func() { serverDone <- struct{}{} }()
			conn, err := listener.Accept()
			if err != nil {
				return
			}
			serverMu.Lock()
			accepted = conn
			serverMu.Unlock()
			accepts.Add(1)
			defer conn.Close()
			(&http2.Server{}).ServeConn(conn, &http2.ServeConnOpts{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				if r.ProtoMajor != 2 || r.Method != http.MethodPost || r.Header.Get("Content-Type") != "application/dns-message" {
					http.Error(w, "invalid DoH", 400)
					return
				}
				wire, err := io.ReadAll(io.LimitReader(r.Body, 65536))
				_ = r.Body.Close()
				var request dnsmessage.Message
				if err != nil || request.Unpack(wire) != nil || len(request.Questions) != 1 || request.Questions[0].Type != dnsmessage.TypeA {
					http.Error(w, "invalid question", 400)
					return
				}
				queries.Add(1)
				question := request.Questions[0]
				response := dnsmessage.Message{Header: dnsmessage.Header{ID: request.ID, Response: true, RecursionAvailable: true}, Questions: request.Questions, Answers: []dnsmessage.Resource{{Header: dnsmessage.ResourceHeader{Name: question.Name, Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET, TTL: 120}, Body: &dnsmessage.AResource{A: [4]byte{192, 0, 2, 43}}}}}
				wire, err = response.Pack()
				if err != nil {
					http.Error(w, "invalid response", 500)
					return
				}
				w.Header().Set("Content-Type", "application/dns-message")
				_, _ = w.Write(wire)
			})})
		}()
		connectionCanceled := make(chan struct{}, 1)
		var retainedMu sync.Mutex
		var retained context.Context
		client := harmonyDoHDispatchConstructor(t, harmonyDoHDispatcher{dispatch: func(ctx context.Context, _ xnet.Destination) (*transport.Link, error) {
			dispatches.Add(1)
			raw, err := (&net.Dialer{Timeout: harmonyDoHTestDeadline}).DialContext(ctx, "tcp", listener.Addr().String())
			if err != nil {
				return nil, err
			}
			conn := &harmonyDoHOwnedConn{Conn: raw}
			retainedMu.Lock()
			retained = ctx
			retainedMu.Unlock()
			context.AfterFunc(ctx, func() {
				_ = conn.Close()
				select {
				case connectionCanceled <- struct{}{}:
				default:
				}
			})
			link, _, _ := harmonyDoHPipeLink(conn)
			return link, nil
		}})
		for _, domain := range []string{"first.example", "second.example", "third.example"} {
			ctx, cancel := context.WithTimeout(harmonyDoHCoreContext(), harmonyDoHTestDeadline)
			ips, ttl, err := client.QueryIP(ctx, domain, dnsfeature.IPOption{IPv4Enable: true})
			cancel()
			if err != nil || len(ips) != 1 || !ips[0].Equal(net.IPv4(192, 0, 2, 43)) || ttl == 0 {
				t.Fatalf("production dispatcher wire DNS failed: %s ips=%v ttl=%d err=%v", domain, ips, ttl, err)
			}
			retainedMu.Lock()
			active := retained != nil && retained.Err() == nil
			retainedMu.Unlock()
			if !active {
				t.Fatal("completed query canceled the connection dispatcher context")
			}
		}
		if queries.Load() != 3 || accepts.Load() != 1 || dispatches.Load() != 1 {
			t.Fatalf("three independent DNS queries did not retain one real dispatched connection: queries=%d accepts=%d dispatches=%d", queries.Load(), accepts.Load(), dispatches.Load())
		}
		if err := client.transport.Close(); err != nil {
			t.Fatal(err)
		}
		harmonyDoHReceive(t, connectionCanceled)
		harmonyDoHAssertEmpty(t, client.transport)
	})

	t.Run("overlapping-cold-request-survives-other-request-cancel", func(t *testing.T) {
		server, accepts := harmonyDoHServer(t, harmonyDoHEcho)
		scope := newDoHTransportScope()
		t.Cleanup(func() { _ = scope.Close() })
		a := harmonyDoHConstructor(t, server.URL+"/echo", true, false, false)
		b := harmonyDoHConstructor(t, server.URL+"/echo", true, false, false)
		scope.adopt(a, "dns-via-node")
		scope.adopt(b, "dns-via-node")
		harmonyDoHTrust(t, a.transport, server)
		originalDial := a.transport.h2.DialTLSContext
		entered, release := make(chan struct{}, 1), make(chan struct{})
		var releaseOnce sync.Once
		t.Cleanup(func() { releaseOnce.Do(func() { close(release) }) })
		var dials atomic.Int32
		a.transport.h2.DialTLSContext = func(ctx context.Context, network, addr string, cfg *tls.Config) (net.Conn, error) {
			if dials.Add(1) == 1 {
				entered <- struct{}{}
				select {
				case <-release:
				case <-ctx.Done():
					return nil, ctx.Err()
				case <-time.After(harmonyDoHTestDeadline):
					return nil, errors.New("overlap cold-dial barrier timeout")
				}
			}
			return originalDial(ctx, network, addr, cfg)
		}
		firstCtx, cancelFirst := context.WithTimeout(context.Background(), harmonyDoHTestDeadline)
		defer cancelFirst()
		first := make(chan error, 1)
		go func() { first <- harmonyDoHPost(firstCtx, a, "first-canceled") }()
		harmonyDoHReceive(t, entered)
		secondCtx, cancelSecond := context.WithTimeout(context.Background(), harmonyDoHTestDeadline)
		defer cancelSecond()
		getConn := make(chan struct{}, 1)
		var gotConn atomic.Int32
		secondCtx = httptrace.WithClientTrace(secondCtx, &httptrace.ClientTrace{
			GetConn: func(string) {
				select {
				case getConn <- struct{}{}:
				default:
				}
			},
			GotConn: func(httptrace.GotConnInfo) { gotConn.Add(1) },
		})
		second := make(chan error, 1)
		go func() { second <- harmonyDoHPost(secondCtx, b, "overlapping-survivor") }()
		harmonyDoHReceive(t, getConn)
		// GetConn proves the second request has entered connection acquisition
		// while the first cold dial is blocked. It does not expose HTTP2's private
		// waiter list; no claim about its exact internal scheduling is needed.
		if gotConn.Load() != 0 || accepts.Load() != 0 {
			t.Fatal("cold acquisition barrier unexpectedly already owns a socket")
		}
		select {
		case err := <-second:
			t.Fatalf("second request finished before cold dial release: %v", err)
		default:
		}
		cancelFirst()
		if err := harmonyDoHReceive(t, first); !errors.Is(err, context.Canceled) {
			t.Fatalf("overlapping first canceled request result: %v", err)
		}
		if secondCtx.Err() != nil || a.transport.ctx.Err() != nil {
			t.Fatal("canceling one caller poisoned the other request or pool lifetime")
		}
		releaseOnce.Do(func() { close(release) })
		if err := harmonyDoHReceive(t, second); err != nil {
			t.Fatal("overlapping second cold request failed:", err)
		}
		if accepts.Load() != 1 || gotConn.Load() != 1 {
			t.Fatalf("surviving request did not use one accepted TLS connection: accepts=%d GotConn=%d", accepts.Load(), gotConn.Load())
		}
		if err := harmonyDoHPostBounded(a, "reuse-after-overlap"); err != nil {
			t.Fatal(err)
		}
		if accepts.Load() != 1 {
			t.Fatal("third request reopened a surviving HTTP2 socket")
		}
		t.Logf("overlapping cold requests: DialTLS attempts=%d, accepted TLS sockets=%d; GetConn is an acquisition barrier, not an internal waiter-list observation", dials.Load(), accepts.Load())
	})
}
